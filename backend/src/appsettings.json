{
  "AllowedOrigins": ["https://localhost"],
  "LogsPath": "logs",
  "ErrorHandling": {
    "ExposeDetails": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
