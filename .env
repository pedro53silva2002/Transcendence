# ─────────────────────────────────────────
 # Nginx
 # ─────────────────────────────────────────
 NGINX_PORT=80

 # ─────────────────────────────────────────
 # Backend
 # ─────────────────────────────────────────
 BACKEND_PORT=8080

 # ─────────────────────────────────────────
 # PostgreSQL
 # ─────────────────────────────────────────
 POSTGRES_PORT=5432
 POSTGRES_DB=transcendence
 POSTGRES_USER=transcendence_user
 POSTGRES_PASSWORD=transcendence_pass

 # ─────────────────────────────────────────
 # Redis
 # ─────────────────────────────────────────
 REDIS_PORT=6379

 # ─────────────────────────────────────────
 # MinIO (S3-compatible storage)
 # ─────────────────────────────────────────
 MINIO_PORT=9000
 MINIO_CONSOLE_PORT=9001
 MINIO_ROOT_USER=minioadmin
 MINIO_ROOT_PASSWORD=minioadmin123

 # ─────────────────────────────────────────
 # JWT  (used by Spring via application.yml)
 # NOTE: secret must be >= 32 characters for HS256
 # Change this before deploying to any shared environment
 # ─────────────────────────────────────────
 JWT_SECRET=change-me-to-a-secure-random-secret-key-min-32-chars
 JWT_ACCESS_TOKEN_TTL_MINUTES=15
 JWT_REFRESH_TOKEN_TTL_DAYS=7