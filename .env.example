# Nginx
NGINX_PORT=8080

# Backend (must match nginx/nginx.conf upstream port)
BACKEND_PORT=5024

# Environment (Development | Production)
ENVIRONMENT=Production

# Frontend
FRONTEND_PORT=80

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_DB=transcendence
POSTGRES_USER=transcendence_user
POSTGRES_PASSWORD=transcendence_pass

# Redis
REDIS_PORT=6379

# MinIO
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# JWT — variable names use __ so ASP.NET Core maps them to the Jwt config section
# Jwt__SecretKey must be at least 32 characters (256-bit HS256)
Jwt__Issuer=localhost
Jwt__Audience=trippie-web
Jwt__SecretKey=dev-secret-change-in-production-please
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=7
Jwt__ClockSkewSeconds=0

VITE_API_URL=/api
# ─────────────────────────────────────────
# Google Oauth configuration
# ─────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=<google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=<backend-url>/api/auth/google/callback
FRONTEND_OAUTH=<frontend-url>/auth/callback
# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=<frontend-url>
FRONTEND_OAUTH_SUCCESS_URI=<redirect-uri>
